# Copie para Closure/.env e preencha. Nunca commite o .env nem cole no chat.

# Chave da Gemini (AI Studio), usada pelos testes de personagem em Closure/ferramentas/
GEMINI_API_KEY=

# Chave de API do Google Cloud pra Vertex AI, criada no projeto do bot (é onde o crédito mensal abate)
VERTEX_API_KEY=

# Ordem dos modelos, "provedor:modelo,..." (provedores: gemini = gratuito, vertex = pago).
# Vazio = padrão do código: gratuito primeiro, pago só quando a cota do dia acaba
FILA_MODELOS=

# Vazio preserva FILA_MODELOS. gemini-4-argon testa Argon na Vertex com Flash de reserva;
# gemini-3.8-flash escolhe a fila padrão. misto usa Argon só nos ARGON_CANAIS.
# Reinicie após mudar. Reflexão usa Flash pago.
MODELO_CHAT=
# ID/número do MESMO projeto da chave Vertex; Argon e Flash 3.8 usam a rota explícita global quando preenchido.
VERTEX_PROJETO=
# Teto conjunto de raciocínio + resposta do Argon; padrão 4096. Não força esse consumo.
ARGON_MAX_SAIDA=
# No modo misto, somente estes canais tentam Argon. Vazio = nenhum. IDs separados por vírgula.
ARGON_CANAIS=
# Parcela do teto mensal que o Argon pode consumir; padrão US$ 1, zero desativa.
# Inclui reservas por chamadas sem informação de consumo. Não se soma ao teto global.
ARGON_TETO_USD=
# Original por padrão. compacto-v1 ou compacto-v2 usa perfil experimental apenas nas chamadas Argon.
ARGON_PERFIL=

# Quanto o modelo pensa antes de falar: low, medium, high, ou "modelo" pro padrão do próprio modelo.
# Vazio = low: no teste de 13/10/2026 custou 42% menos e respondeu em menos da metade do tempo
RACIOCINIO=

# Quanto o modelo pago pode gastar por mês, em dólar, antes de o bot tirar ele da fila. Vazio = 9
TETO_MENSAL_USD=
# Como o teto soma: cheio (padrão, preço de tabela sem promoção) ou promocional. Cheio é o lado seguro enquanto
# a fatura não mostrar se o crédito do mês abate antes ou depois da promoção.
TETO_PRECO=
# Gasto do mês que este bot não vê (baterias e testes em outro banco), em dólar, lido na fatura e atualizado à mão.
# Entra no teto global. Vazio = 0
GASTO_EXTERNO_USD=

# Token do app no Discord (Developer Portal > seu app > Bot > Reset Token)
DISCORD_TOKEN=

# ID de um servidor de teste: nele os comandos de barra aparecem na hora (opcional)
GUILD_ID=

# ID de quem pode usar /teste_webhook (o do Mizuki está em Closure/dados/personagem/servidor.md)
DONO_ID=

# Canais em que o bot escuta, separados por vírgula. Vazio = todos
CANAIS=

# Imagem de cada personagem nas mensagens (URL pública)
AVATAR_KALTSIT=
AVATAR_CLOSURE=

# Só o bot antigo (Closure Legado) usa: chave da OpenWeatherMap. O bot novo lê o clima da Open-Meteo, sem chave
WEATHER_API_KEY=

# Link público da política de privacidade (o texto é o Closure/docs/PRIVACIDADE.md). Aparece no fim do /meus_dados.
POLITICA_URL=
# Link público dos termos de uso (o texto é o Closure/docs/TERMOS.md). Aparece no /ajuda.
TERMOS_URL=
# Link do livro de regras em PDF, que o /livro e o GC:livro mandam. Vazio = o do site do sistema.
LIVRO_URL=

# Canais que já nascem com o painel diário de clima, um por servidor, separados por vírgula.
# O comando /clima_canal faz o mesmo de dentro do Discord.
CLIMA_CANAIS=

# Cifra no disco o texto que o bot guarda de gente (falas, mensagens do dia, fichas).
# Não escreva à mão: rode  python3 -m closure_bot --gerar-chave  de dentro de Closure/src.
# Faça cópia. Sem a chave as fichas e as falas guardadas não abrem mais.
CHAVE_DO_BANCO=
