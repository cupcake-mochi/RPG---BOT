# Copie para Closure/.env e preencha. Nunca commite o .env nem cole no chat.

# Chave da Gemini (AI Studio), usada pelos testes de personagem em Closure/ferramentas/
GEMINI_API_KEY=

# Token do app no Discord (Developer Portal > seu app > Bot > Reset Token)
DISCORD_TOKEN=

# ID de um servidor de teste: nele os comandos de barra aparecem na hora (opcional)
GUILD_ID=

# ID de quem pode usar /teste_webhook (o do Mizuki está em Closure/dados/personagem/servidor.md)
DONO_ID=

# Canais em que o bot escuta, separados por vírgula. Vazio = todos
CANAIS=

# Imagem de cada personagem nas mensagens (URL pública)
AVATAR_KALTSIT=
AVATAR_CLOSURE=

# Só o bot antigo (Closure Legado) usa: chave da OpenWeatherMap. O bot novo lê o clima da Open-Meteo, sem chave
WEATHER_API_KEY=
